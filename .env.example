# Copiá a .env.local para desarrollo. En Vercel: Project → Settings → Environment Variables.

# TurboWarp + bridge WebSocket (lobby, room, publicación a Scratch).
# false = la app abre directo en el selector de modalidades; micro:bit sigue funcionando.
# true  = lobby con sesión, chip TurboWarp y panel WS en modo avanzado.
VITE_ENABLE_TURBOWARP=false
